# PDFlow Environment Configuration
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to version control!

# Required: Google Gemini API Key
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Node Environment (development/production)
NODE_ENV=production

# Optional: Logging Configuration
LOG_LEVEL=info
ENABLE_FILE_LOGGING=true
LOG_RETENTION_DAYS=7

# Optional: Next.js Configuration
NEXT_TELEMETRY_DISABLED=1

# Optional: CORS Configuration
# Comma-separated list of allowed origins (no wildcard by default — same-origin only)
# Example: CORS_ALLOWED_ORIGINS=https://example.com,https://app.example.com
CORS_ALLOWED_ORIGINS=

# Optional: Allowed HTTP methods (default: GET,POST,OPTIONS)
# CORS_ALLOWED_METHODS=GET,POST,OPTIONS

# Optional: Allowed request headers (default: Content-Type,Authorization)
# CORS_ALLOWED_HEADERS=Content-Type,Authorization

# Optional: Preflight cache max-age in seconds (default: 86400 = 24 hours)
# CORS_MAX_AGE=86400

# Optional: Port Configuration (for local development)
# Note: Docker uses internal port 3000, mapped to external 3535
PORT=3001
